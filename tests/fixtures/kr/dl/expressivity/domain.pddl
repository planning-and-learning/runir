(define (domain expressivity)
  (:requirements :strips :negative-preconditions)
  (:constants a b c)
  (:predicates (p ?x) (q ?x) (e ?x ?y) (f ?x ?y) (flag))
  (:action add-p :parameters (?x) :precondition (not (p ?x)) :effect (p ?x))
  (:action del-p :parameters (?x) :precondition (p ?x) :effect (not (p ?x)))
  (:action add-q :parameters (?x) :precondition (not (q ?x)) :effect (q ?x))
  (:action del-q :parameters (?x) :precondition (q ?x) :effect (not (q ?x)))
  (:action add-e :parameters (?x ?y) :precondition (not (e ?x ?y)) :effect (e ?x ?y))
  (:action del-e :parameters (?x ?y) :precondition (e ?x ?y) :effect (not (e ?x ?y)))
  (:action add-f :parameters (?x ?y) :precondition (not (f ?x ?y)) :effect (f ?x ?y))
  (:action del-f :parameters (?x ?y) :precondition (f ?x ?y) :effect (not (f ?x ?y)))
  (:action set-flag :parameters () :precondition (not (flag)) :effect (flag))
  (:action clear-flag :parameters () :precondition (flag) :effect (not (flag))))
