(:program
    (:entry sokoban)
    (:module
        (:symbol sokoban)
        (:arguments)
        (:registers (:concept current_box))
        (:entry select_box)
        (:memory select_box deliver_box)
        (:datalog
            (:rule (obj ?x) (object ?x))
            (:rule (unfinished ?b) (goal at ?b ?l) (not (at ?b ?l)))
            (:rule (selected ?b) (current_box ?b))
            (:rule (remaining-count ?n) (count ?n ((unfinished ?b))))
            (:rule (box-at ?l) (current_box ?b) (at ?b ?l))
            (:rule (box-goal ?l) (current_box ?b) (goal at ?b ?l))
            (:rule (free ?l) (clear ?l))
            (:rule (free ?l) (box-at ?l))
            (:rule (delivery ?r ?bl (min 0)) (at-robot ?r) (box-at ?bl))
            (:rule (delivery ?nr ?bl (min ?v)) (delivery ?r ?bl ?w) (adjacent ?r ?nr ?d) (free ?nr) (!= ?nr ?bl) (= ?v (+ ?w 1)))
            (:rule (delivery ?bl ?nbl (min ?v)) (delivery ?r ?bl ?w) (adjacent ?r ?bl ?d) (adjacent ?bl ?nbl ?d) (free ?nbl) (= ?v (+ ?w 1)))
            (:rule (delivered (min ?w)) (delivery ?r ?bl ?w) (box-goal ?bl) (object ?r))
            (:rule (has-goal ?b) (goal at ?b ?g))
            (:rule (open ?b ?l) (has-goal ?b) (clear ?l))
            (:rule (open ?b ?l) (at ?b ?l))
            (:rule (probe ?c) (goal at ?b ?c) (not (at ?b ?c)))
            (:rule (cut ?c) (box-goal ?c) (probe ?c))
            (:rule (reach ?b ?r ?bl (min 0)) (unfinished ?b) (cut ?c) (not (escaped ?b)) (not (current_box ?b)) (at ?b ?bl) (at-robot ?r))
            (:rule (reach ?b ?nr ?bl (min ?v)) (reach ?b ?r ?bl ?w) (adjacent ?r ?nr ?d) (open ?b ?nr) (!= ?nr ?bl) (= ?v (+ ?w 1)))
            (:rule (reach ?b ?bl ?nbl (min ?v)) (reach ?b ?r ?bl ?w) (adjacent ?r ?bl ?d) (adjacent ?bl ?nbl ?d) (open ?b ?nbl) (= ?v (+ ?w 1)))
            (:rule (avoid ?b ?r ?bl (min 0)) (unfinished ?b) (not (current_box ?b)) (at ?b ?bl) (at-robot ?r) (not (cut ?r)) (not (cut ?bl)))
            (:rule (avoid ?b ?nr ?bl (min ?v)) (avoid ?b ?r ?bl ?w) (adjacent ?r ?nr ?d) (open ?b ?nr) (!= ?nr ?bl) (not (cut ?nr)) (= ?v (+ ?w 1)))
            (:rule (avoid ?b ?bl ?nbl (min ?v)) (avoid ?b ?r ?bl ?w) (adjacent ?r ?bl ?d) (adjacent ?bl ?nbl ?d) (open ?b ?nbl) (not (cut ?nbl)) (= ?v (+ ?w 1)))
            (:rule (deliverable ?b (min ?w)) (reach ?b ?r ?g ?w) (goal at ?b ?g) (adjacent ?r ?g ?d))
            (:rule (escapes ?b (min ?w)) (avoid ?b ?r ?g ?w) (goal at ?b ?g) (adjacent ?r ?g ?d))
            (:rule (escaped ?b) (escapes ?b ?w))
            (:rule (blocked ?b) (deliverable ?b ?w) (cut ?c) (not (escaped ?b)) (not (current_box ?b)))
            (:rule (blocked-count ?n) (count ?n ((blocked ?b)))))
        (:features
            (:concept (:symbol objects) (:head obj))
            (:concept (:symbol unfinished_boxes) (:head unfinished))
            (:concept (:symbol selected_box) (:head selected))
            (:numerical (:symbol remaining) (:head remaining-count))
            (:numerical (:symbol delivery_distance) (:head delivered))
            (:numerical (:symbol goal_blocking_deliveries) (:head blocked-count)))
        (:rules
            (:rule
                (:symbol select_delivery)
                (:expression
                    (:source-memory select_box)
                    (:target-memory deliver_box)
                    (:choose
                        (:conditions)
                        (:concept unfinished_boxes)
                        (:register
                            (:concept current_box)
                        )
                        (:effects (unchanged remaining))
                        (:order (min goal_blocking_deliveries))
                    )
                )
            )
            (:rule
                (:symbol approach)
                (:expression
                    (:source-memory deliver_box)
                    (:target-memory deliver_box)
                    (:do
                        (:conditions)
                        (:action "move")
                        (:arguments objects objects objects)
                        (:effects (unchanged remaining) (decreases delivery_distance))
                    )
                )
            )
            (:rule
                (:symbol advance_box)
                (:expression
                    (:source-memory deliver_box)
                    (:target-memory deliver_box)
                    (:do
                        (:conditions)
                        (:action "push")
                        (:arguments objects objects objects objects selected_box)
                        (:effects (unchanged remaining) (decreases delivery_distance))
                    )
                )
            )
            (:rule
                (:symbol finish_delivery)
                (:expression
                    (:source-memory deliver_box)
                    (:target-memory select_box)
                    (:do
                        (:conditions)
                        (:action "push")
                        (:arguments objects objects objects objects selected_box)
                        (:effects (decreases delivery_distance) (decreases remaining))
                    )
                )
            )
        )
    )
)
