# Tests: literal values are the test data, and fixed seeds keep runs reproducible. Tests read
# optionals with value(), whose bad_optional_access fails the test: the check cannot see gtest's
# ASSERTs. Concept tests shadow a method to show that the concept rejects the type, and validation
# tests cast invalid enum values to show they are rejected. The allocation tests replace operator
# new with malloc and free what it allocates. Tests run on Linux, so thread safety follows glibc,
# whose getenv is thread-safe (no test calls setenv).
InheritParentConfig: true
Checks: >
  -cppcoreguidelines-avoid-magic-numbers,
  -bugprone-random-generator-seed,
  -bugprone-derived-method-shadowing-base-method,
  -cppcoreguidelines-owning-memory,
  -cppcoreguidelines-no-malloc,
  -clang-analyzer-optin.core.EnumCastOutOfRange
CheckOptions:
  bugprone-unchecked-optional-access.IgnoreValueCalls: true
  concurrency-mt-unsafe.FunctionSet: glibc

